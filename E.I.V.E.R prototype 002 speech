def confirm_action(action):

    speak(
        f"Please confirm: {action}. "
        "Say yes or no."
    )

    answer = listen()

    return answer in [
        "yes",
        "yeah",
        "yes eiver",
        "confirm"
    ]


# -------------------------------------------------------
# Main Command Processor
# -------------------------------------------------------

def process_command(command):

    if not command:

        return True

    command = command.lower().strip()

    # ----------------------------------------------
    # Exit
    # ----------------------------------------------

    if command in [
        "exit",
        "quit",
        "goodbye",
        "shutdown assistant",
        "go offline"
    ]:

        speak(
            "Going offline. Goodbye."
        )

        return False

    # ----------------------------------------------
    # Greetings
    # ----------------------------------------------

    if command in [
        "hello",
        "hi",
        "hey",
        "hello eiver"
    ]:

        speak(
            "Hello. E.I.V.E.R. is online and ready."
        )

        return True

    # ----------------------------------------------
    # Identity
    # ----------------------------------------------

    if (
        "who are you" in command
        or "what are you" in command
    ):

        speak(
            "I am E.I.V.E.R., "
            "your Enhanced Intelligent Virtual "
            "Executive Response assistant."
        )

        return True

    # ----------------------------------------------
    # Capabilities
    # ----------------------------------------------

    if (
        "what can you do" in command
        or "help" == command
    ):

        show_help()

        return True

    # ----------------------------------------------
    # Time
    # ----------------------------------------------

    if (
        "what time" in command
        or "current time" in command
    ):

        tell_time()

        return True

    # ----------------------------------------------
    # Date
    # ----------------------------------------------

    if (
        "what is the date" in command
        or "what's the date" in command
        or "today's date" in command
    ):

        tell_date()

        return True

    # ----------------------------------------------
    # System Status
    # ----------------------------------------------

    if (
        "system status" in command
        or "system check" in command
        or "check the system" in command
    ):

        system_status()

        return True

    # ----------------------------------------------
    # Computer Information
    # ----------------------------------------------

    if (
        "computer information" in command
        or "computer specs" in command
        or "system information" in command
    ):

        computer_information()

        return True

    # ----------------------------------------------
    # Web Search
    # ----------------------------------------------

    if command.startswith(
        "search for "
    ):

        query = command[
            len("search for "):
        ]

        web_search(query)

        return True

    if command.startswith(
        "search "
    ):

        query = command[
            len("search "):
        ]

        web_search(query)

        return True

    # ----------------------------------------------
    # Websites
    # ----------------------------------------------

    if command.startswith(
        "open "
    ):

        target = command[
            len("open "):
        ].strip()

        if open_website(target):

            return True

        if open_application(target):

            return True

    # ----------------------------------------------
    # Calculator
    # ----------------------------------------------

    if command.startswith(
        "calculate "
    ):

        expression = command[
            len("calculate "):
        ]

        result = safe_calculate(
            expression
        )

        speak(
            f"The answer is {result}."
        )

        return True

    # ----------------------------------------------
    # Memory
    # ----------------------------------------------

    if command.startswith(
        "remember that "
    ):

        remember(command)

        return True

    if (
        "what do you remember" in command
    ):

        recall_memory(command)

        return True

    # ----------------------------------------------
    # Forget memory
    # ----------------------------------------------

    if command == "forget memory":

        if confirm_action(
            "erase all stored memory"
        ):

            memory.clear()

            save_memory(memory)

            speak(
                "All stored memory has been erased."
            )

        else:

            speak(
                "Memory deletion cancelled."
            )

        return True

    # ----------------------------------------------
    # Basic conversation
    # ----------------------------------------------

    if (
        "how are you" in command
    ):

        speak(
            "All systems are functioning normally."
        )

        return True

    if (
        "thank you" in command
        or "thanks" in command
    ):

        speak(
            "You're welcome."
        )

        return True

    # ----------------------------------------------
    # Unknown command
    # ----------------------------------------------

    speak(
        "I don't have a built-in function for that "
        "yet. You can ask me to search the web."
    )

    return True


