# -------------------------------------------------------
# Open Applications
# -------------------------------------------------------

def open_application(app):

    app = app.lower().strip()

    system = platform.system()

    # Windows
    if system == "Windows":

        applications = {

            "notepad":
                "notepad.exe",

            "calculator":
                "calc.exe",

            "paint":
                "mspaint.exe",

            "file explorer":
                "explorer.exe",

            "explorer":
                "explorer.exe",

        }

        if app in applications:

            try:

                subprocess.Popen(
                    applications[app]
                )

                speak(
                    f"Opening {app}."
                )

                return True

            except Exception:

                pass

    # Linux
    elif system == "Linux":

        applications = {

            "calculator":
                "gnome-calculator",

            "file manager":
                "nautilus",

            "files":
                "nautilus",

        }

        if app in applications:

            try:

                subprocess.Popen(
                    applications[app]
                )

                speak(
                    f"Opening {app}."
                )

                return True

            except Exception:

                pass

    # macOS
    elif system == "Darwin":

        applications = {

            "calculator":
                "Calculator",

            "text editor":
                "TextEdit",

            "finder":
                "Finder",

        }

        if app in applications:

            try:

                subprocess.Popen(
                    ["open", "-a", applications[app]]
                )

                speak(
                    f"Opening {app}."
                )

                return True

            except Exception:

                pass

    return False


# -------------------------------------------------------
# Memory Commands
# -------------------------------------------------------

def remember(command):

    text = command.replace(
        "remember that",
        "",
        1
    ).strip()

    if not text:

        speak(
            "What would you like me to remember?"
        )

        return

    if "=" in text:

        key, value = text.split(
            "=",
            1
        )

        key = key.strip()
        value = value.strip()

        memory[key] = value

    else:

        key = f"memory_{len(memory) + 1}"

        memory[key] = text

    save_memory(memory)

    speak(
        "I have saved that to memory."
    )


def recall_memory(command):

    if not memory:

        speak(
            "My memory is currently empty."
        )

        return

    question = command.replace(
        "what do you remember",
        "",
        1
    ).strip()

    if question:

        for key, value in memory.items():

            if question.lower() in (
                key.lower()
                + " "
                + value.lower()
            ):

                speak(
                    f"I remember that {value}."
                )

                return

    speak(
        "Here is what I remember:"
    )

    for key, value in memory.items():

        speak(
            f"{key}: {value}"
        )


