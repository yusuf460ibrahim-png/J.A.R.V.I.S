
import tkinter as tk
import math
import datetime
import platform
import webbrowser

try:
    import psutil
except ImportError:
    psutil = None


# ============================================================
# E.I.V.E.R. SIMPLE INTERFACE
# ============================================================

class EIVER:

    def __init__(self, root):

        self.root = root

        self.root.title(
            "E.I.V.E.R. - AI SYSTEM"
        )

        self.root.geometry(
            "1100x700"
        )

        self.root.configure(
            bg="#050505"
        )

        self.angle = 0

        self.create_interface()

        self.animate()

        self.update_clock()

        self.update_system()

        self.write(
            "E.I.V.E.R. SYSTEM INITIALIZED"
        )

        self.write(
            "AI CORE ONLINE"
        )

        self.write(
            "READY FOR COMMAND"
        )

    # ========================================================
    # INTERFACE
    # ========================================================

    def create_interface(self):

        # ----------------------------------------------------
        # TITLE
        # ----------------------------------------------------

        title = tk.Label(
            self.root,
            text="E.I.V.E.R.",
            bg="#050505",
            fg="#ff2020",
            font=("Consolas", 28, "bold")
        )

        title.pack(
            pady=(15, 0)
        )

        subtitle = tk.Label(
            self.root,
            text="ENHANCED INTELLIGENT VIRTUAL EXECUTIVE RESPONSE",
            bg="#050505",
            fg="#777777",
            font=("Consolas", 9)
        )

        subtitle.pack()

        # ----------------------------------------------------
        # CLOCK
        # ----------------------------------------------------

        self.clock = tk.Label(
            self.root,
            bg="#050505",
            fg="#ff3030",
            font=("Consolas", 11)
        )

        self.clock.pack(
            pady=5
        )

        # ----------------------------------------------------
        # MAIN AREA
        # ----------------------------------------------------

        main = tk.Frame(
            self.root,
            bg="#050505"
        )

        main.pack(
            fill="both",
            expand=True,
            padx=20,
            pady=10
        )

        # ----------------------------------------------------
        # LEFT PANEL
        # ----------------------------------------------------

        left = tk.Frame(
            main,
            bg="#090909",
            highlightbackground="#661010",
            highlightthickness=1
        )

        left.pack(
            side="left",
            fill="y",
            padx=(0, 10)
        )

        tk.Label(
            left,
            text="SYSTEM",
            bg="#090909",
            fg="#ff2020",
            font=("Consolas", 12, "bold")
        ).pack(
            pady=15
        )

        self.cpu = self.make_status(
            left,
            "CPU"
        )

        self.memory = self.make_status(
            left,
            "MEMORY"
        )

        self.disk = self.make_status(
            left,
            "DISK"
        )

        self.network = self.make_status(
            left,
            "NETWORK"
        )

        self.security = self.make_status(
            left,
            "SECURITY"
        )

        # ----------------------------------------------------
        # CENTER
        # ----------------------------------------------------

        center = tk.Frame(
            main,
            bg="#050505"
        )

        center.pack(
            side="left",
            fill="both",
            expand=True
        )

        tk.Label(
            center,
            text="AI CORE",
            bg="#050505",
            fg="#ff2020",
            font=("Consolas", 12, "bold")
        ).pack()

        self.canvas = tk.Canvas(
            center,
            bg="#050505",
            highlightthickness=0
        )

        self.canvas.pack(
            fill="both",
            expand=True
        )

        # ----------------------------------------------------
        # RIGHT DATA PANEL
        # ----------------------------------------------------

        right = tk.Frame(
            main,
            bg="#090909",
            highlightbackground="#661010",
            highlightthickness=1,
            width=230
        )

        right.pack(
            side="right",
            fill="y",
            padx=(10, 0)
        )

        tk.Label(
            right,
            text="DATA STREAM",
            bg="#090909",
            fg="#ff2020",
            font=("Consolas", 12, "bold")
        ).pack(
            pady=15
        )

        self.data = tk.Text(
            right,
            width=25,
            bg="#050505",
            fg="#bb2222",
            insertbackground="#ff2020",
            font=("Consolas", 8),
            relief="flat"
        )

        self.data.pack(
            fill="both",
            expand=True,
            padx=10,
            pady=10
        )

        self.data.config(
            state="disabled"
        )

        # ----------------------------------------------------
        # TERMINAL
        # ----------------------------------------------------

        terminal_frame = tk.Frame(
            self.root,
            bg="#050505"
        )

        terminal_frame.pack(
            fill="x",
            padx=20
        )

        tk.Label(
            terminal_frame,
            text="COMMAND TERMINAL",
            bg="#050505",
            fg="#ff2020",
            font=("Consolas", 10, "bold")
        ).pack(
            anchor="w"
        )

        self.output = tk.Text(
            terminal_frame,
            height=6,
            bg="#030303",
            fg="#ff3030",
            insertbackground="#ff3030",
            font=("Consolas", 9),
            relief="flat",
            highlightbackground="#661010",
            highlightthickness=1
        )

        self.output.pack(
            fill="x"
        )

        self.output.config(
            state="disabled"
        )

        # ----------------------------------------------------
        # COMMAND BOX
        # ----------------------------------------------------

        command_frame = tk.Frame(
            self.root,
            bg="#050505"
        )

        command_frame.pack(
            fill="x",
            padx=20,
            pady=15
        )

        self.command = tk.Entry(
            command_frame,
            bg="#0a0a0a",
            fg="#eeeeee",
            insertbackground="#ff2020",
            font=("Consolas", 11),
            relief="flat",
            highlightbackground="#661010",
            highlightthickness=1
        )

        self.command.pack(
            side="left",
            fill="x",
            expand=True,
            ipady=8
        )

        self.command.bind(
            "<Return>",
            self.execute
        )

        button = tk.Button(
            command_frame,
            text="EXECUTE",
            command=self.execute,
            bg="#180606",
            fg="#ff3030",
            activebackground="#661010",
            activeforeground="#ffffff",
            font=("Consolas", 10, "bold"),
            relief="flat"
        )

        button.pack(
            side="right",
            padx=(10, 0),
            ipadx=20,
            ipady=6
        )

    # ========================================================
    # STATUS BOX
    # ========================================================

    def make_status(
        self,
        parent,
        name
    ):

        frame = tk.Frame(
            parent,
            bg="#090909"
        )

        frame.pack(
            fill="x",
            padx=15,
            pady=8
        )

        tk.Label(
            frame,
            text=name,
            bg="#090909",
            fg="#666666",
            font=("Consolas", 9)
        ).pack(
            anchor="w"
        )

        label = tk.Label(
            frame,
            text="ONLINE",
            bg="#090909",
            fg="#ff3030",
            font=("Consolas", 15, "bold")
        )

        label.pack(
            anchor="w"
        )

        return label

    # ========================================================
    # DRAW AI CORE
    # ========================================================

    def animate(self):

        self.canvas.delete(
            "all"
        )

        width = self.canvas.winfo_width()
        height = self.canvas.winfo_height()

        if width < 100:
            self.root.after(
                50,
                self.animate
            )
            return

        cx = width / 2
        cy = height / 2

        radius = min(
            width,
            height
        ) * 0.25

        # ----------------------------------------------------
        # GRID
        # ----------------------------------------------------

        for x in range(
            0,
            width,
            40
        ):

            self.canvas.create_line(
                x,
                0,
                x,
                height,
                fill="#170707"
            )

        for y in range(
            0,
            height,
            40
        ):

            self.canvas.create_line(
                0,
                y,
                width,
                y,
                fill="#170707"
            )

        # ----------------------------------------------------
        # CIRCLES
        # ----------------------------------------------------

        for i in range(4):

            r = radius + (
                i * 25
            )

            self.canvas.create_oval(
                cx - r,
                cy - r,
                cx + r,
                cy + r,
                outline="#661010",
                width=2
            )

        # ----------------------------------------------------
        # ROTATING LINES
        # ----------------------------------------------------

        for i in range(8):

            angle = math.radians(
                self.angle
                + i * 45
            )

            r = radius + 75

            x = (
                cx
                + math.cos(angle) * r
            )

            y = (
                cy
                + math.sin(angle) * r
            )

            self.canvas.create_line(
                cx,
                cy,
                x,
                y,
                fill="#7a1111",
                width=1
            )

        # ----------------------------------------------------
        # CORE
        # ----------------------------------------------------

        self.canvas.create_oval(
            cx - radius * 0.6,
            cy - radius * 0.6,
            cx + radius * 0.6,
            cy + radius * 0.6,
            fill="#330909",
            outline="#ff2020",
            width=3
        )

        self.canvas.create_oval(
            cx - radius * 0.3,
            cy - radius * 0.3,
            cx + radius * 0.3,
            cy + radius * 0.3,
            fill="#8b1010",
            outline="#ff3030",
            width=2
        )

        self.canvas.create_oval(
            cx - 12,
            cy - 12,
            cx + 12,
            cy + 12,
            fill="#ff3030",
            outline="#ffaaaa",
            width=2
        )

        # ----------------------------------------------------
        # LABEL
        # ----------------------------------------------------

        self.canvas.create_text(
            cx,
            cy + radius + 110,
            text="E.I.V.E.R.",
            fill="#ff3030",
            font=("Consolas", 18, "bold")
        )

        self.canvas.create_text(
            cx,
            cy + radius + 135,
            text="AI CORE ACTIVE",
            fill="#772020",
            font=("Consolas", 9)
        )

        self.angle += 2

        if self.angle >= 360:
            self.angle = 0

        self.root.after(
            30,
            self.animate
        )

    # ========================================================
    # CLOCK
    # ========================================================

    def update_clock(self):

        now = datetime.datetime.now()

        self.clock.config(
            text=now.strftime(
                "%A  |  %d %B %Y  |  %H:%M:%S"
            )
        )

        self.root.after(
            1000,
            self.update_clock
        )

    # ========================================================
    # SYSTEM MONITOR
    # ========================================================

    def update_system(self):

        if psutil:

            try:

                cpu = psutil.cpu_percent()

                memory = (
                    psutil.virtual_memory()
                    .percent
                )

                disk = (
                    psutil.disk_usage(
                        "C:\\"
                    ).percent
                    if platform.system()
                    == "Windows"
                    else
                    psutil.disk_usage(
                        "/"
                    ).percent
                )

                self.cpu.config(
                    text=f"{cpu:.1f}%"
                )

                self.memory.config(
                    text=f"{memory:.1f}%"
                )

                self.disk.config(
                    text=f"{disk:.1f}%"
                )

            except Exception:

                pass

        self.network.config(
            text="ONLINE"
        )

        self.security.config(
            text="ACTIVE"
        )

        self.update_data()

        self.root.after(
            1000,
            self.update_system
        )

    # ========================================================
    # DATA STREAM
    # ========================================================

    def update_data(self):

        self.data.config(
            state="normal"
        )

        self.data.delete(
            "1.0",
            tk.END
        )

        for _ in range(18):

            line = ""

            for _ in range(30):

                line += str(
                    int(
                        datetime.datetime.now()
                        .microsecond
                        % 2
                    )
                )

            self.data.insert(
                tk.END,
                line + "\n"
            )

        self.data.config(
            state="disabled"
        )

    # ========================================================
    # TERMINAL OUTPUT
    # ========================================================

    def write(
        self,
        message
    ):

        self.output.config(
            state="normal"
        )

        time = datetime.datetime.now().strftime(
            "%H:%M:%S"
        )

        self.output.insert(
            tk.END,
            f"[{time}] {message}\n"
        )

        self.output.see(
            tk.END
        )

        self.output.config(
            state="disabled"
        )

    # ========================================================
    # COMMAND SYSTEM
    # ========================================================

    def execute(
        self,
        event=None
    ):

        command = (
            self.command
            .get()
            .strip()
        )

        if not command:
            return

        self.command.delete(
            0,
            tk.END
        )

        self.write(
            "> " + command
        )

        text = command.lower()

        # HELP
        if text == "help":

            self.write(
                "COMMANDS:"
            )

            self.write(
                "status"
            )

            self.write(
                "time"
            )

            self.write(
                "system"
            )

            self.write(
                "open google"
            )

            self.write(
                "open youtube"
            )

            self.write(
                "search <query>"
            )

            self.write(
                "clear"
            )

            return

        # STATUS
        if text == "status":

            self.write(
                "E.I.V.E.R. CORE: ONLINE"
            )

            self.write(
                "NETWORK: ONLINE"
            )

            self.write(
                "SECURITY: ACTIVE"
            )

            return

        # TIME
        if text == "time":

            self.write(
                datetime.datetime.now()
                .strftime(
                    "Current time: %H:%M:%S"
                )
            )

            return

        # SYSTEM
        if text == "system":

            self.write(
                "OS: "
                + platform.system()
            )

            self.write(
                "VERSION: "
                + platform.release()
            )

            self.write(
                "MACHINE: "
                + platform.machine()
            )

            return

        # CLEAR
        if text == "clear":

            self.output.config(
                state="normal"
            )

            self.output.delete(
                "1.0",
                tk.END
            )

            self.output.config(
                state="disabled"
            )

            return

        # OPEN
        if text.startswith(
            "open "
        ):

            target = text[5:].strip()

            websites = {

                "google":
                    "https://www.google.com",

                "youtube":
                    "https://www.youtube.com",

                "github":
                    "https://github.com",

                "wikipedia":
                    "https://www.wikipedia.org"
            }

            if target in websites:

                webbrowser.open(
                    websites[target]
                )

                self.write(
                    "Opening "
                    + target
                )

                return

        # SEARCH
        if text.startswith(
            "search "
        ):

            query = command[7:].strip()

            if query:

                url = (
                    "https://www.google.com/search?q="
                    + query.replace(
                        " ",
                        "+"
                    )
                )

                webbrowser.open(
                    url
                )

                self.write(
                    "Searching for: "
                    + query
                )

                return

        self.write(
            "Unknown command."
        )

        self.write(
            "Type HELP for commands."
        )


# ============================================================
# START
# ============================================================

root = tk.Tk()

app = EIVER(
    root
)

root.mainloop()
